\newcommand{\paperTitleCN}{基于深度学习的灵巧手内旋转系统的设计与实现}
\newcommand{\thesisbodyfont}{\songti\normalsize\selectfont}
\newcommand{\thesisheadertext}{\songti\zihao{-5}\paperTitleCN}
\newcommand{\checkedbox}{\mbox{$\Box\kern-0.7em\checkmark$}}

\setlength{\headheight}{15pt}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\thesisheadertext}
\fancyfoot[C]{\zihao{-5}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\makeatletter
\newcommand{\cqusetheader}[1]{%
  \fancyhf{}%
  \fancyhead[L]{\thesisheadertext}%
  \fancyhead[R]{\songti\zihao{-5}#1}%
  \fancyfoot[C]{\zihao{-5}\thepage}%
  \pagestyle{fancy}%
}
\makeatother

\newcommand{\thesisfrontmatterpage}[1]{%
  \clearpage
  \pagestyle{fancy}%
  \phantomsection
  \cqusetheader{#1}%
  \markboth{#1}{}%
  \thispagestyle{fancy}%
}

\newcommand{\thesischapterpage}[1]{%
  \clearpage
  \pagestyle{fancy}%
  \phantomsection
  \cqusetheader{#1}%
  \markboth{#1}{}%
  \thispagestyle{fancy}%
}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\thesisheadertext}%
  \fancyfoot[C]{\zihao{-5}\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

